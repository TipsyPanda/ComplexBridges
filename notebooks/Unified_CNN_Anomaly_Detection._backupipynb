height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"><span style=\"font-weight: bold\"> Total params: </span><span style=\"color: #00af00; text-decoration-color: #00af00\">167,937</span> (656.00 KB)\n","</pre>\n"]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["\u001b[1m Trainable params: \u001b[0m\u001b[38;5;34m167,041\u001b[0m (652.50 KB)\n"],"text/html":["<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"><span style=\"font-weight: bold\"> Trainable params: </span><span style=\"color: #00af00; text-decoration-color: #00af00\">167,041</span> (652.50 KB)\n","</pre>\n"]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["\u001b[1m Non-trainable params: \u001b[0m\u001b[38;5;34m896\u001b[0m (3.50 KB)\n"],"text/html":["<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"><span style=\"font-weight: bold\"> Non-trainable params: </span><span style=\"color: #00af00; text-decoration-color: #00af00\">896</span> (3.50 KB)\n","</pre>\n"]},"metadata":{}}],"source":["def build_cnn_model(input_shape, n_filters=[64, 128, 256], kernel_sizes=[5, 3, 3], dropout_rate=0.3):\n","    \"\"\"\n","    Build 1D CNN architecture for multi-sensor anomaly detection\n","\n","    Args:\n","        input_shape: (window_size, n_sensors)\n","        n_filters: List of filter numbers for each conv layer\n","        kernel_sizes: List of kernel sizes for each conv layer\n","        dropout_rate: Dropout rate for regularization\n","\n","    Returns:\n","        Keras model\n","    \"\"\"\n","    print(\"\\nBuilding 1D CNN model...\")\n","    print(f\"Input shape: {input_shape}\")\n","\n","    model = models.Sequential(name='MultiSensor_1D_CNN')\n","\n","    # Input layer\n","    model.add(layers.Input(shape=input_shape))\n","\n","    # Conv Block 1\n","    model.add(layers.Conv1D(n_filters[0], kernel_sizes[0], padding='same', activation='relu'))\n","    model.add(layers.BatchNormalization())\n","    model.add(layers.MaxPooling1D(pool_size=2))\n","    model.add(layers.Dropout(dropout_rate))\n","\n","    # Conv Block 2\n","    model.add(layers.Conv1D(n_filters[1], kernel_sizes[1], padding='same', activation='relu'))\n","    model.add(layers.BatchNormalization())\n","    model.add(layers.MaxPooling1D(pool_size=2))\n","    model.add(layers.Dropout(dropout_rate))\n","\n","    # Conv Block 3\n","    model.add(layers.Conv1D(n_filters[2], kernel_sizes[2], padding='same', activation='relu'))\n","    model.add(layers.BatchNormalization())\n","    model.add(layers.GlobalMaxPooling1D())  # Global pooling instead of flattening\n","    model.add(layers.Dropout(dropout_rate))\n","\n","    # Dense layers\n","    model.add(layers.Dense(128, activation='relu'))\n","    model.add(layers.Dropout(dropout_rate))\n","    model.add(layers.Dense(64, activation='relu'))\n","    model.add(layers.Dropout(dropout_rate))\n","\n","    # Output layer (binary classification)\n","    model.add(layers.Dense(1, activation='sigmoid'))\n","\n","    return model\n","\n","# Build model\n","input_shape = (WINDOW_SIZE, X.shape[2])  # (window_size, n_sensors)\n","model = build_cnn_model(input_shape)\n","\n","# Display model architecture\n","model.summary()"]},{"cell_type":"code","execution_count":20,"metadata":{"id":"Vcz_YNPcLChH","executionInfo":{"status":"ok","timestamp":1764580260082,"user_tz":-60,"elapsed":265,"user":{"displayName":"","userId":""}},"outputId":"f1c6ea0d-e08a-4663-8e41-d542889cf81e","colab":{"base_uri":"https://localhost:8080/","height":1000}},"outputs":[{"output_type":"execute_result","data":{"image/png":"\n","text/plain":["<IPython.core.display.Image object>"]},"metadata":{},"execution_count":20}],"source":["# Visualize model architecture\n","keras.utils.plot_model(\n","    model,\n","    show_shapes=True,\n","    show_layer_names=True,\n","    rankdir='TB',\n","    expand_nested=True,\n","    dpi=96\n",")"]},{"cell_type":"markdown","metadata":{"id":"AdA3VbVNLChH"},"source":["## 9. Model Compilation"]},{"cell_type":"code","execution_count":21,"metadata":{"id":"YXC7kFw1LChH","executionInfo":{"status":"ok","timestamp":1764580260107,"user_tz":-60,"elapsed":24,"user":{"displayName":"","userId":""}},"outputId":"09cc1b45-7056-4a8b-c7c1-e2f0c92763b9","colab":{"base_uri":"https://localhost:8080/"}},"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Class weights: {0: 1.0, 1: np.float64(3.104575163398693)}\n","\n","Model compiled successfully!\n"]}],"source":["# Calculate class weights to handle imbalance\n","n_normal = (y_train == 0).sum()\n","n_anomaly = (y_train == 1).sum()\n","class_weight = {0: 1.0, 1: n_normal / n_anomaly if n_anomaly > 0 else 1.0}\n","\n","print(f\"\\nClass weights: {class_weight}\")\n","\n","# Compile model\n","model.compile(\n","    optimizer=keras.optimizers.Adam(learning_rate=LEARNING_RATE),\n","    loss='binary_crossentropy',\n","    metrics=['accuracy',\n","             keras.metrics.Precision(name='precision'),\n","             keras.metrics.Recall(name='recall'),\n","             keras.metrics.AUC(name='auc')]\n",")\n","\n","print(\"\\nModel compiled successfully!\")"]},{"cell_type":"markdown","metadata":{"id":"dnecU-T-LChH"},"source":["## 10. Training"]},{"cell_type":"code","execution_count":22,"metadata":{"id":"EeIgjiEALChH","executionInfo":{"status":"ok","timestamp":1764580260131,"user_tz":-60,"elapsed":23,"user":{"displayName":"","userId":""}},"outputId":"6ae61843-94ce-48ce-8db6-4aec1c1dc9b1","colab":{"base_uri":"https://localhost:8080/"}},"outputs":[{"output_type":"stream","name":"stdout","text":["======================================================================\n","TRAINING MODEL\n","======================================================================\n"]}],"source":["# Callbacks\n","callbacks = [\n","    keras.callbacks.EarlyStopping(\n","        monitor='val_loss',\n","        patience=10,\n","        restore_best_weights=True,\n","        verbose=1\n","    ),\n","    keras.callbacks.ReduceLROnPlateau(\n","        monitor='val_loss',\n","        factor=0.5,\n","        patience=5,\n","        min_lr=1e-7,\n","        verbose=1\n","    ),\n","    keras.callbacks.ModelCheckpoint(\n","        os.path.join(MODEL_DIR, 'best_model.keras'),\n","        monitor='val_loss',\n","        save_best_only=True,\n","        verbose=1\n","    )\n","]\n","\n","print(\"=\"*70)\n","print(\"TRAINING MODEL\")\n","print(\"=\"*70)"]},{"cell_type":"code","execution_count":23,"metadata":{"id":"Wc8zt7GkLChH","executionInfo":{"status":"ok","timestamp":1764580286584,"user_tz":-60,"elapsed":26452,"user":{"displayName":"","userId":""}},"outputId":"0d975e00-3885-4a57-8485-c77ecdb34d6c","colab":{"base_uri":"https://localhost:8080/"}},"outputs":[{"output_type":"stream","name":"stdout","text":["Epoch 1/50\n","\u001b[1m20/20\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 355ms/step - accuracy: 0.7841 - auc: 0.8765 - loss: 0.7957 - precision: 0.5815 - recall: 0.8638\n","Epoch 1: val_loss improved from inf to 0.44830, saving model to artifacts/unified_cnn/best_model.keras\n","\u001b[1m20/20\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m19s\u001b[0m 479ms/step - accuracy: 0.7885 - auc: 0.8802 - loss: 0.7802 - precision: 0.5864 - recall: 0.8661 - val_accuracy: 0.9071 - val_auc: 1.0000 - val_loss: 0.4483 - val_precision: 0.7253 - val_recall: 1.0000 - learning_rate: 0.0010\n","Epoch 2/50\n","\u001b[1m16/20\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m━━━━\u001b[0m \u001b[1m0s\u001b[0m 3ms/step - accuracy: 0.9493 - auc: 0.9852 - loss: 0.2508 - precision: 0.8673 - recall: 0.9563 \n","Epoch 2: val_loss improved from 0.44830 to 0.30367, saving model to artifacts/unified_cnn/best_model.keras\n","\u001b[1m20/20\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[